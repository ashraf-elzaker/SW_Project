# Production Environment Variables
DEBUG=False
ENVIRONMENT=production

ALLOWED_HOSTS=your-production-app.azurewebsites.net
SECRET_KEY=production-secret-key-change-this-to-a-strong-key

DATABASE_URL=postgresql://user:password@postgres-prod.postgres.database.azure.com/dbname
DATABASE_SSL_REQUIRED=true

CORS_ALLOWED_ORIGINS=https://your-production-app.azurewebsites.net

JWT_EXPIRATION_HOURS=24

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Logging
LOG_LEVEL=WARNING

# Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
