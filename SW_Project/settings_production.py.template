    MIDDLEWARE.insert(1, 'whitenoise.middleware.WhiteNoiseMiddleware')
    # Enable compression and caching
    WHITENOISE_COMPRESSION_QUALITY = 80
    WHITENOISE_COMPRESS_OFFLINE = True

# Media files
MEDIA_URL = '/media/'
