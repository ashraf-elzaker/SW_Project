# Staging Environment Variables
DEBUG=False
ENVIRONMENT=staging

ALLOWED_HOSTS=your-staging-app.azurewebsites.net,localhost
SECRET_KEY=staging-secret-key-change-this

DATABASE_URL=postgresql://user:password@postgres-staging.postgres.database.azure.com/dbname
DATABASE_SSL_REQUIRED=true

CORS_ALLOWED_ORIGINS=https://your-staging-app.azurewebsites.net

JWT_EXPIRATION_HOURS=24

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Logging
LOG_LEVEL=INFO
